---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CLOUD_KEYS, clouds, cloudOf } from "../../data/clouds";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const counts = Object.fromEntries(
  CLOUD_KEYS.map((key) => [key, posts.filter((p) => cloudOf(p.data.cloud) === key).length]),
);
---

<BaseLayout
  title="Clouds"
  description="Browse posts by cloud: AWS, GCP, Azure, and cross-cloud bridges."
>
  <h1>Clouds</h1>
  <p>One collection, three clouds, and the bridge that maps a technique across them.</p>
  <ul class="pillar-grid">
    {CLOUD_KEYS.map((key) => (
      <li class="pillar-card">
        <a href={`/clouds/${key}/`}>
          <span class="badge-letter">{clouds[key].label}</span>
          <span class="pillar-label">{clouds[key].tagline}</span>
          <span class="pillar-count">
            {counts[key]} post{counts[key] === 1 ? "" : "s"}
          </span>
        </a>
        <p>{clouds[key].description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>