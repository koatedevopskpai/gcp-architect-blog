---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { CLOUD_KEYS, clouds, cloudOf, type CloudKey } from "../../data/clouds";

export async function getStaticPaths() {
  return CLOUD_KEYS.map((cloud) => ({
    params: { cloud },
    props: { cloud },
  }));
}

interface Props {
  cloud: CloudKey;
}

const { cloud } = Astro.props;
const meta = clouds[cloud];

const posts = (
  await getCollection("posts", ({ data }) => !data.draft && cloudOf(data.cloud) === cloud)
).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);
---

<BaseLayout title={meta.label} description={meta.description}>
  <header class="page-header">
    <p class="eyebrow">{meta.tagline}</p>
    <h1>{meta.label} posts</h1>
    <p>{meta.description}</p>
  </header>
  <ul class="post-list">
    {posts.map((post) => (
      <li><PostCard post={post} /></li>
    ))}
  </ul>
  {posts.length === 0 && <p>No posts published on {meta.label} yet.</p>}
</BaseLayout>