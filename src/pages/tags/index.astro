---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { slugify } from "../../lib/utils";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const tagMap = new Map<string, { label: string; count: number }>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    const slug = slugify(tag);
    const existing = tagMap.get(slug);
    if (existing) existing.count += 1;
    else tagMap.set(slug, { label: tag, count: 1 });
  }
}
const tags = [...tagMap.entries()].sort((a, b) => b[1].count - a[1].count);
---

<BaseLayout title="Tags" description="All topics covered on the blog.">
  <h1>Tags</h1>
  <ul class="tag-cloud">
    {tags.map(([slug, { label, count }]) => (
      <li><a href={`/tags/${slug}/`}>#{label} <span class="tag-count">{count}</span></a></li>
    ))}
  </ul>
  {tags.length === 0 && <p>No tags yet.</p>}
</BaseLayout>
