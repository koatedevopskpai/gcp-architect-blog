---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { CATEGORY_KEYS, categories, type CategoryKey } from "../../data/categories";

export async function getStaticPaths() {
  return CATEGORY_KEYS.map((category) => ({
    params: { category },
    props: { category },
  }));
}

interface Props {
  category: CategoryKey;
}

const { category } = Astro.props;
const meta = categories[category];

const posts = (
  await getCollection("posts", ({ data }) => !data.draft && data.category === category)
).sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<BaseLayout title={meta.label} description={meta.description}>
  <header class="page-header">
    <p class="eyebrow">Pillar {meta.letter}</p>
    <h1>{meta.label}</h1>
    <p>{meta.description}</p>
    {meta.requiresOrg && (
      <p class="badge"><span class="badge-letter">!</span><span>Requires a GCP organization</span></p>
    )}
  </header>
  <ul class="post-list">
    {posts.map((post) => (
      <li><PostCard post={post} /></li>
    ))}
  </ul>
  {posts.length === 0 && <p>No posts published in this pillar yet.</p>}
</BaseLayout>
