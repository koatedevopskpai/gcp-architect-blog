---
import { slugify } from "../lib/utils";

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{tags.length > 0 && (
  <ul class="tag-list" aria-label="Tags">
    {tags.map((tag) => (
      <li>
        <a href={`/tags/${slugify(tag)}/`}>#{tag}</a>
      </li>
    ))}
  </ul>
)}
