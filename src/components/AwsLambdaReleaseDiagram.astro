<figure class="release-diagram" aria-labelledby="lambda-release-caption">
  <figcaption id="lambda-release-caption">Request flow and release control</figcaption>

  <div class="request-flow" aria-label="Request flow">
    <div class="step">HTTP API</div>
    <span class="arrow" aria-hidden="true">→</span>
    <div class="step">Lambda alias <code>live</code></div>
  </div>
  <div class="branches">
    <div class="step"><span class="allocation">Configured 90%</span><strong>Version 2</strong><span>Healthy</span></div>
    <div class="step"><span class="allocation">Configured 10%</span><strong>Version 3</strong><span>Faulty candidate</span></div>
  </div>

  <div class="control-label">Failure detection and recovery</div>
  <ol class="control-flow" aria-label="Failure detection and recovery sequence">
    <li>Version 3 raises an unhandled exception</li>
    <li>Lambda <code>Errors</code> metric records failures</li>
    <li>CloudWatch alarm enters <code>ALARM</code></li>
    <li>CodeDeploy stops the release and starts automatic rollback</li>
    <li><strong>Alias restored to version 2 at 100%</strong></li>
  </ol>
  <p class="diagram-note">Traffic weights are configured allocations, not measured request shares.</p>
</figure>

