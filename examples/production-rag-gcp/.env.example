# Local runs default to in-memory + deterministic embeddings (zero deps).
VECTOR_BACKEND=memory        # memory | pgvector
EMBEDDING_PROVIDER=           # empty = deterministic | vertex

# Cloud Run + Cloud SQL (pgvector):
# VECTOR_BACKEND=pgvector
# CLOUD_SQL_CONNECTION_NAME=project:region:instance
# DB_NAME=rag
# DB_USER=rag
# DB_PASSWORD=...            # from Secret Manager in prod
